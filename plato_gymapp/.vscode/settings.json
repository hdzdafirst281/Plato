{
    "java.configuration.updateBuildConfiguration": "interactive",

    // 1. Chỉ định đường dẫn đến thư mục chứa file JSON của slang
    "i18n-ally.localesPaths": [
        "lib/i18n"
    ],

    // 2. Ngôn ngữ gốc và ngôn ngữ hiển thị
    "i18n-ally.sourceLanguage": "en",
    "i18n-ally.displayLanguage": "vi",
    "i18n-ally.keystyle": "nested",
    "i18n-ally.enabledParsers": ["json"],

    // 3. Khai báo framework để kích hoạt extension
    "i18n-ally.enabledFrameworks": [
        "flutter",
        "general"
    ],

    // 4. Regex để i18n-ally nhận diện cú pháp của slang: t.key
    "i18n-ally.regex.usageMatch": [
        // Bắt cú pháp của slang, ví dụ: t.common.save
        "t\\.({key})"
    ],

    // 5. Khai báo format tên file JSON để extension tải đúng locale
    "i18n-ally.pathMatcher": "strings_{locale}.i18n.json"
}